# Copy this file to .env and fill in your values.

# Required for the browser-use agent (scraper-browser-use.py)
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1

# Browser settings
HEADLESS=false
MAX_STEPS=50
MAX_ACTIONS_PER_STEP=10

# Run guard: max allowed runs per host within the time window (in minutes)
RUN_MAX_RUNS=5
RUN_WINDOW_MINUTES=1440

